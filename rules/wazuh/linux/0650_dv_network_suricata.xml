<!-- Network IDS & Suricata Integration Rules (IDs 100650-100679)
     Telemetry: Suricata EVE JSON (/var/log/suricata/eve.json) decoded by Wazuh json/suricata decoder.
     Covers: C2 beaconing (Cobalt Strike, Sliver), DNS tunneling, malicious egress. -->
<group name="local,network,suricata,ids,dv_validation,">

  <!-- Base Suricata EVE Alert parent (Wazuh stock or custom decoded) -->
  <rule id="100650" level="3">
    <decoded_as>json</decoded_as>
    <field name="event_type">^alert$</field>
    <description>Suricata IDS alert event.</description>
  </rule>

  <!-- C2 Beaconing: Cobalt Strike default malleable profiles -->
  <rule id="100651" level="13">
    <if_sid>100650</if_sid>
    <field name="alert.signature" type="pcre2">(?i)Cobalt\s*Strike|CobaltStrike|Beaconing\s+HTTP</field>
    <description>Network IDS: Cobalt Strike C2 beaconing activity detected by Suricata.</description>
    <mitre><id>T1071.001</id><id>T1573</id></mitre>
    <group>command_and_control,c2_beacon,</group>
  </rule>

  <!-- C2 Beaconing: Sliver C2 framework HTTP/mTLS communication -->
  <rule id="100652" level="13">
    <if_sid>100650</if_sid>
    <field name="alert.signature" type="pcre2">(?i)Sliver\s+C2|Sliver\s+Implant|BishopFox\s+Sliver</field>
    <description>Network IDS: Sliver C2 framework network traffic detected by Suricata.</description>
    <mitre><id>T1071.001</id><id>T1573</id></mitre>
    <group>command_and_control,c2_beacon,</group>
  </rule>

  <!-- DNS Tunneling / Data Exfiltration -->
  <rule id="100653" level="12">
    <if_sid>100650</if_sid>
    <field name="alert.signature" type="pcre2">(?i)DNS\s+Tunneling|Iodine|dnscat2|High\s+Entropy\s+DNS\s+Query</field>
    <description>Network IDS: Suspicious DNS tunneling or high-entropy subdomain exfiltration.</description>
    <mitre><id>T1071.004</id><id>T1048.003</id></mitre>
    <group>command_and_control,exfiltration,</group>
  </rule>

</group>

