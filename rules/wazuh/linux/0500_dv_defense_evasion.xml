<!-- Defense evasion: logging, auditing, firewall and MAC being tampered with. -->
<group name="local,defense_evasion,dv_validation,">

  <rule id="100500" level="12">
    <program_name>^systemd$</program_name>
    <regex type="pcre2">(?i)Stopp(ed|ing) (Security )?Audit(ing)? (Service|Daemon)|Stopp(ed|ing) System Logging Service|Stopp(ed|ing) .*rsyslog|Stopp(ed|ing) Wazuh (agent|Agent)</regex>
    <description>Logging, auditing or Wazuh agent service stopped.</description>
    <mitre><id>T1562.001</id></mitre>
    <group>service_stopped,</group>
  </rule>

  <rule id="100501" level="10">
    <program_name>^systemd$</program_name>
    <regex type="pcre2">(?i)Stopp(ed|ing) (firewalld|Uncomplicated firewall|Netfilter Persistent|nftables)</regex>
    <description>Host firewall service stopped.</description>
    <mitre><id>T1562.004</id></mitre>
    <group>service_stopped,</group>
  </rule>

  <rule id="100502" level="12">
    <decoded_as>auditd</decoded_as>
    <regex type="pcre2">type=MAC_STATUS[^\n]*enforcing=0</regex>
    <description>SELinux switched to permissive mode.</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="100503" level="13">
    <decoded_as>auditd</decoded_as>
    <regex type="pcre2">type=CONFIG_CHANGE[^\n]*auid=(?!4294967295)\d+[^\n]*(audit_enabled=0|op=remove_rule)</regex>
    <description>Audit rules removed or auditing disabled by a logged-in user.</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

</group>
