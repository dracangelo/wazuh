<!-- Credential access. 100904-100905 and 100908 need domain controller audit policy. -->
<group name="local,windows,credential_access,dv_validation,">

  <rule id="100900" level="13">
    <if_sid>100715</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1038|1410|1438|143a|1f0fff|1f1fff|1f2fff|1f3fff|1fffff)$</field>
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)\\(MsMpEng|csrss|wininit|lsm|services|svchost|taskmgr|procexp64?|vmtoolsd|SenseIR|WmiPrvSE|werfault)\.exe$</field>
    <description>Suspicious process access to lsass.exe memory.</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <rule id="100901" level="14">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs\.dll\W+#?(24|minidump)|procdump\S*\s+.*lsass|\s-ma\s+lsass</field>
    <description>LSASS memory dump attempted via comsvcs or procdump.</description>
    <mitre><id>T1003.001</id></mitre>
  </rule>

  <rule id="100902" level="13">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\breg(\.exe)?\s+(save|export)\s+"?(hklm|hkey_local_machine)\\(sam|security|system)\b</field>
    <description>Registry hive export of SAM, SECURITY or SYSTEM.</description>
    <mitre><id>T1003.002</id></mitre>
  </rule>

  <rule id="100903" level="12">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(ntdsutil.*\b(ifm|snapshot)\b|vssadmin\S*\s+create\s+shadow|\bntds\.dit\b|diskshadow)</field>
    <description>Active Directory database or shadow-copy credential extraction pattern.</description>
    <mitre><id>T1003.003</id></mitre>
  </rule>

  <rule id="100904" level="0">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.providerName">^Microsoft-Windows-Security-Auditing$</field>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.serviceName" negate="yes" type="pcre2">(\$$|^krbtgt$)</field>
    <description>Base: Kerberos service ticket requested with RC4 for a user service account.</description>
  </rule>

  <rule id="100905" level="11" frequency="10" timeframe="60">
    <if_matched_sid>100904</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Many RC4 Kerberos service tickets from one source (Kerberoasting).</description>
    <mitre><id>T1558.003</id></mitre>
  </rule>

  <rule id="100906" level="8">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\b(vaultcmd(\.exe)?\s+/list|cmdkey(\.exe)?\s+/list)</field>
    <description>Stored credentials enumerated with vaultcmd or cmdkey.</description>
    <mitre><id>T1555.004</id></mitre>
  </rule>

  <rule id="100907" level="14">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sekurlsa::|lsadump::|kerberos::(ptt|golden|list)|privilege::debug|token::elevate|dpapi::)</field>
    <description>Mimikatz command syntax on a command line.</description>
    <mitre><id>T1003</id></mitre>
  </rule>

  <rule id="100908" level="14">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.providerName">^Microsoft-Windows-Security-Auditing$</field>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">(?i)(1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c)</field>
    <field name="win.eventdata.subjectUserName" negate="yes" type="pcre2">\$$</field>
    <description>Directory replication rights used by a non-machine account (DCSync).</description>
    <mitre><id>T1003.006</id></mitre>
  </rule>

</group>