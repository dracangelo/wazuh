<!-- Discovery, lateral movement and less-common evasion techniques. Discovery rules are children of
     Sysmon 1 (100712); timestomp is detected from PowerShell script-block logging (100719) and from
     Sysmon 1 where the command line is visible. ADS needs Sysmon 15 (base 100722); COM hijack needs
     Sysmon 13 (base 100717). Audit policy and script-block logging: agent-config/audit_policy.ps1. -->
<group name="local,windows,sysmon,discovery,dv_validation,">

  <rule id="100873" level="8">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bnet1?(\.exe)?\s+(view|user(\s+\S+)?\s*$|group\s+\S+\s+/domain|accounts\s+/domain|localgroup\s+\S+\s+/domain)\b|\bnltest(\.exe)?\s+/(domain_trusts|dclist|dsgetdc)\b|\bdsquery\b|\badfind(\.exe)?\b</field>
    <description>Windows: Domain, account or network trust discovery command executed.</description>
    <mitre><id>T1087.002</id><id>T1018</id><id>T1482</id></mitre>
    <group>discovery,</group>
  </rule>

  <rule id="100874" level="9">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bwinrs(\.exe)?\s+|\bmstsc(\.exe)?\s+[^\n]*(/v:|/admin)\b|\b(enter|new)-pssession\b|\binvoke-command\b[^\n]*-computername\b</field>
    <description>Windows: Remote session or remote command execution started.</description>
    <mitre><id>T1021.001</id><id>T1021.006</id></mitre>
    <group>lateral_movement,</group>
  </rule>

  <rule id="100875" level="8">
    <if_sid>100719</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(\.lastwritetime\s*=|set-itemproperty[^\n]*lastwritetime|setfiletime|\.creationtime\s*=)</field>
    <description>Windows: PowerShell changed a file timestamp (timestomping).</description>
    <mitre><id>T1070.006</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <rule id="100876" level="8">
    <if_sid>100722</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i):(?!zone\.identifier$)[^:\\\s]+$</field>
    <description>Windows: Alternate data stream created (hidden payload or metadata).</description>
    <mitre><id>T1564.004</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <rule id="100877" level="12">
    <if_sid>100717</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CLSID\\\{[0-9a-f-]+\\}\\InprocServer32</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(\\temp\\|\\appdata\\|\\programdata\\|\\users\\public\\)</field>
    <description>Windows: COM CLSID InprocServer32 pointed at a user-writable path (COM hijack).</description>
    <mitre><id>T1546.015</id></mitre>
    <group>persistence,defense_evasion,</group>
  </rule>

  <rule id="100878" level="8">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(lastwritetime\s*=|setfiletime|set-itemproperty[^\n]*(creationtime|lastwritetime|lastaccesstime))</field>
    <description>Windows: Command line changes file timestamps (timestomping).</description>
    <mitre><id>T1070.006</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <rule id="100879" level="7">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\bwevtutil(\.exe)?\s+(el|enum-logs)\b|Get-WinEvent\s+-ListLog)</field>
    <description>Windows: Enumeration of security or system event log sources.</description>
    <mitre><id>T1082</id></mitre>
    <group>discovery,</group>
  </rule>

  <rule id="100880" level="8">
    <if_sid>100712</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\bTest-NetConnection\b[^\n]*-Port|\bportqry(\.exe)?\b)</field>
    <description>Windows: Network service port probe or connectivity scan.</description>
    <mitre><id>T1046</id></mitre>
    <group>discovery,</group>
  </rule>

</group>
