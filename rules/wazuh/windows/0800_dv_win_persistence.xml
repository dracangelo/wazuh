<!-- Persistence: services, scheduled tasks, registry autoruns, WMI, startup folders, FIM. -->
<group name="local,windows,persistence,dv_validation,">

  <rule id="100800" level="6">
    <if_sid>100720</if_sid>
    <description>Windows: New service installed.</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

  <rule id="100801" level="12">
    <if_sid>100800</if_sid>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)(cmd(\.exe)?\s|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript|%comspec%|\\(temp|appdata|programdata|users\\public)\\)|^"?\\\\[^\\]+\\</field>
    <description>Windows: Service installed with a suspicious binary path.</description>
    <mitre><id>T1543.003</id></mitre>
  </rule>

  <rule id="100802" level="12">
    <if_sid>100800</if_sid>
    <field name="win.eventdata.serviceName" type="pcre2">(?i)^(psexesvc|paexec|remcom|csexec)</field>
    <description>Windows: Remote-execution service installed (PsExec style).</description>
    <mitre><id>T1569.002</id><id>T1021.002</id></mitre>
  </rule>

  <rule id="100803" level="6">
    <if_sid>100721</if_sid>
    <description>Windows: Scheduled task created.</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <rule id="100804" level="12">
    <if_sid>100803</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)&lt;Command&gt;[^&lt;]*(powershell|pwsh|cmd\.exe|mshta|wscript|cscript|rundll32|regsvr32|\\temp\\|\\appdata\\|\\programdata\\|\\users\\public\\)</field>
    <description>Windows: Scheduled task runs a script engine or a user-writable path.</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <rule id="100805" level="10">
    <if_sid>100717</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\(Wow6432Node\\)?Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce|RunServices|RunOnceEx|Policies\\Explorer\\Run)\\[^\\]+$</field>
    <description>Windows: Registry Run key value set.</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="100806" level="10">
    <if_sid>100716</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\[^\\]+$</field>
    <description>Windows: File created in a Startup folder.</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="100807" level="12">
    <if_sid>100718</if_sid>
    <description>Windows: WMI event subscription activity (filter, consumer or binding).</description>
    <mitre><id>T1546.003</id></mitre>
  </rule>

  <rule id="100808" level="12">
    <if_sid>100717</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Image File Execution Options\\[^\\]+\\(Debugger|GlobalFlag)$|\\Windows NT\\CurrentVersion\\Winlogon\\(Shell|Userinit|Notify)|\\CurrentVersion\\Windows\\(AppInit_DLLs|Load)$</field>
    <description>Windows: IFEO, Winlogon or AppInit persistence value set.</description>
    <mitre><id>T1546.012</id><id>T1547.004</id><id>T1546.010</id></mitre>
  </rule>

  <rule id="100809" level="14">
    <if_sid>100716</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\windows\\system32\\(sethc|utilman|osk|narrator|magnify|displayswitch)\.exe$</field>
    <description>Windows: Accessibility binary created or replaced (logon-screen backdoor).</description>
    <mitre><id>T1546.008</id></mitre>
  </rule>

  <rule id="100813" level="10">
    <if_sid>100717</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Control\\Terminal Server\\fDenyTSConnections$</field>
    <field name="win.eventdata.details" type="pcre2">DWORD \(0x00000000\)</field>
    <description>Windows: Remote Desktop enabled via registry.</description>
    <mitre><id>T1021.001</id></mitre>
  </rule>

</group>

<group name="local,windows,syscheck,persistence,dv_validation,">

  <rule id="100810" level="8">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\windows\\system32\\drivers\\etc\\hosts$</field>
    <description>FIM: Windows hosts file changed.</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100811" level="10">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\start menu\\programs\\startup\\</field>
    <description>FIM: Startup folder content changed.</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="100812" level="8">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\windows\\system32\\tasks\\</field>
    <description>FIM: Scheduled task definition file changed.</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

</group>